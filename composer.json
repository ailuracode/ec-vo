{
    "name": "ailuracode/ec-validator",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "AiluraCode\\EcValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiluraCode\\EcValidator\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Pablo Santiago Guerra",
            "email": "livesanty_@hotmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "pestphp/pest": "^2.0"
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest",
        "test:coverage": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
